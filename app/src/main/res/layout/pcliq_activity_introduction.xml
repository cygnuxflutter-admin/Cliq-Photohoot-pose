<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0D0B"
    android:fitsSystemWindows="true"
    tools:context=".PCliq_Activity.PCliq_IntroductionActivity">

    <!-- Intro Slides ViewPager -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vpg_intro_activity__intro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Action Bar (Back + Skip) -->
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/pcliq_bg_circle_button"
        android:backgroundTint="#33FFFFFF"
        android:contentDescription="Back"
        android:padding="8dp"
        android:src="@drawable/pcliq_ic_back_clean"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_skip"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/pcliq_bg_badge_gold"
        android:fontFamily="@font/pcliq_leaguespartan_semibold"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="SKIP →"
        android:textColor="@color/white"
        android:textSize="11.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Controls (Indicator Dots + Next Button) -->
    <LinearLayout
        android:id="@+id/ll_dots_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/dot_0"
            android:layout_width="22dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pcliq_dot_active" />

        <View
            android:id="@+id/dot_1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pcliq_dot_inactive" />

        <View
            android:id="@+id/dot_2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pcliq_dot_inactive" />

        <View
            android:id="@+id/dot_3"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/pcliq_dot_inactive" />

        <View
            android:id="@+id/dot_4"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/pcliq_dot_inactive" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_next"
        android:layout_width="120dp"
        android:layout_height="44dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/pcliq_bg_button_gold"
        android:elevation="4dp"
        android:fontFamily="@font/pcliq_leaguespartan_semibold"
        android:gravity="center"
        android:text="Next"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>