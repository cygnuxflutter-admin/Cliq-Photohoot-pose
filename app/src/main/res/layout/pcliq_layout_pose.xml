<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rootlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:strokeColor="#20C19543"
        app:strokeWidth="1.2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Pose Image -->
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/iv_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                app:riv_corner_radius="18dp" />

            <!-- Dark Bottom Scrim Gradient for text readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_alignBottom="@+id/iv_wallpaper"
                android:background="@drawable/pcliq_bg_pose_gradient" />

            <!-- Optional PRO Badge (Top Left) -->
            <TextView
                android:id="@+id/tv_pro_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/pcliq_bg_pro_badge"
                android:fontFamily="@font/pcliq_leaguespartan_bold"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="PRO"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:visibility="gone" />

            <!-- Heart / Favorite Button (Top Right) in Frosted Glass Circle -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_margin="8dp"
                android:background="@drawable/pcliq_bg_fav_circle"
                android:elevation="3dp">

                <com.like.LikeButton
                    android:id="@+id/button_wall_fav"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    app:anim_scale_factor="2"
                    app:circle_end_color="@color/gold_primary"
                    app:circle_start_color="@color/red"
                    app:dots_primary_color="@color/gold_primary"
                    app:dots_secondary_color="@color/gold_secondary"
                    app:icon_size="15dp"
                    app:is_enabled="true"
                    app:like_drawable="@drawable/pcliq_ic_heart_filled"
                    app:unlike_drawable="@drawable/pcliq_ic_heart_outline" />

            </FrameLayout>

            <!-- Bottom Content: Pose Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/iv_wallpaper"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <!-- Pose Title -->
                <TextView
                    android:id="@+id/tv_wall_cat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/pcliq_leaguespartan_semibold"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="Pose Title"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp" />

            </LinearLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Native Ad Container (Same height as portrait pose cards: 280dp) -->
    <RelativeLayout
        android:id="@+id/ad_layout"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/native_banner_ad_container"
            android:layout_width="match_parent"
            android:layout_height="280dp">

            <!-- While Ad is loading: clean card with spinner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                app:cardBackgroundColor="@color/bg_card_warm"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <ProgressBar
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_centerInParent="true"
                        android:indeterminateTint="@color/gold_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="8dp"
                        android:background="@drawable/pcliq_bg_pro_badge"
                        android:fontFamily="@font/pcliq_leaguespartan_bold"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="Ad"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>

    </RelativeLayout>

</FrameLayout>