<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm"
    android:orientation="vertical">

    <com.photo.pose.photoshoot.cliq.PCliq_utils.PCliq_StatusBarView
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_warm" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_proedit"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_warm"
        android:elevation="0dp"
        app:elevation="0dp"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="@string/edit_profile"
        app:titleTextColor="@color/text_espresso" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_warm"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Avatar Picker -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp">

                <View
                    android:id="@+id/view1"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- User Photo -->
                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/iv_profile"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/pcliq_ic_placeholder_square"
                    app:layout_constraintBottom_toBottomOf="@+id/view1"
                    app:layout_constraintEnd_toEndOf="@+id/view1"
                    app:layout_constraintStart_toStartOf="@+id/view1"
                    app:layout_constraintTop_toTopOf="@+id/view1"
                    app:riv_border_color="@color/gold_primary"
                    app:riv_border_width="2dp"
                    app:riv_corner_radius="20dp" />

                <!-- Add / Change Photo Badge -->
                <com.makeramen.roundedimageview.RoundedImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="-4dp"
                    android:layout_marginBottom="-4dp"
                    android:src="@drawable/pcliq_ic_add_prof"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_profile"
                    app:layout_constraintEnd_toEndOf="@+id/iv_profile" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Personal Information Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:fontFamily="serif"
                android:text="@string/personal_information"
                android:textColor="@color/text_espresso"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/pcliq_leaguespartan_semibold"
                android:text="@string/name"
                android:textColor="@color/text_sub_brown"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/editText_profedit_name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/pcliq_bg_edittext"
                android:fontFamily="@font/pcliq_leaguespartan_medium"
                android:hint="@string/name"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_espresso"
                android:textColorHint="@color/text_light_brown"
                android:textSize="15sp" />

            <!-- Email Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/pcliq_leaguespartan_semibold"
                android:text="@string/email"
                android:textColor="@color/text_sub_brown"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/editText_profedit_email"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/pcliq_bg_edittext"
                android:fontFamily="@font/pcliq_leaguespartan_medium"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_espresso"
                android:textColorHint="@color/text_light_brown"
                android:textSize="15sp" />

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/pcliq_leaguespartan_semibold"
                android:text="@string/password"
                android:textColor="@color/text_sub_brown"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/editText_profedit_password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/pcliq_bg_edittext"
                android:fontFamily="@font/pcliq_leaguespartan_medium"
                android:hint="@string/password"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_espresso"
                android:textColorHint="@color/text_light_brown"
                android:textSize="15sp" />

            <!-- Confirm Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/pcliq_leaguespartan_semibold"
                android:text="@string/cpassword"
                android:textColor="@color/text_sub_brown"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/editText_profedit_cpassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/pcliq_bg_edittext"
                android:fontFamily="@font/pcliq_leaguespartan_medium"
                android:hint="@string/cpassword"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_espresso"
                android:textColorHint="@color/text_light_brown"
                android:textSize="15sp" />

            <!-- Phone Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/pcliq_leaguespartan_semibold"
                android:text="@string/phone"
                android:textColor="@color/text_sub_brown"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/editText_profedit_phone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/pcliq_bg_edittext"
                android:fontFamily="@font/pcliq_leaguespartan_medium"
                android:hint="@string/phone"
                android:inputType="phone"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_espresso"
                android:textColorHint="@color/text_light_brown"
                android:textSize="15sp" />

            <!-- Update Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_prof_update"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/pcliq_bg_gradient_curve"
                android:elevation="4dp"
                android:fontFamily="@font/pcliq_leaguespartan_bold"
                android:letterSpacing="0.08"
                android:paddingStart="52dp"
                android:paddingEnd="52dp"
                android:text="@string/update"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Ad Container -->
    <RelativeLayout
        android:id="@+id/rl_ad"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:background="@color/bg_warm"
        android:gravity="center"
        android:visibility="visible" />

</LinearLayout>