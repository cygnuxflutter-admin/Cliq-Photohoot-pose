<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:gravity="center">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_card_warm"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/pcliq_ic_placeholder_camera_icon"
            android:tint="@color/gold_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/pcliq_leaguespartan_bold"
            android:text="No Internet Connection"
            android:textColor="@color/text_title"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/pcliq_leaguespartan_medium"
            android:gravity="center"
            android:text="Please check your internet connection. This dialog will disappear automatically once connection is restored."
            android:textColor="@color/text_desc"
            android:textSize="14sp" />

        <com.photo.pose.photoshoot.cliq.PCliq_utils.PCliq_PhotoshootLoaderView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</RelativeLayout>
