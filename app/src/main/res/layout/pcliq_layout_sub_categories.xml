<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cl_sub_cat"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/pcliq_bg_chip_unselected"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_sub_cat_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pcliq_leaguespartan_medium"
        android:maxLines="1"
        android:text="Standing"
        android:textColor="@color/chip_unselected_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_cat_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/pcliq_leaguespartan_regular"
        android:textColor="@color/chip_unselected_text"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>