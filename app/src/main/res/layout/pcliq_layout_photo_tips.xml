<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pcliq_bg_gradient_top_curve"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Top Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/pcliq_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/pcliq_ic_meta_bulb"
            app:tint="@color/gold_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Pro Photoshoot Guide"
                android:textColor="@color/text_espresso"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pcliq_leaguespartan_regular"
                android:text="Studio secrets for perfect angles and lighting"
                android:textColor="@color/text_sub_brown"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_close_tips"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/pcliq_ic_close"
            app:tint="@color/text_sub_brown" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="#154A3B32" />

    <!-- Scrollable Tips Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="380dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tip 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/pcliq_bg_quick_action_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pcliq_leaguespartan_bold"
                    android:text="🌅 1. Golden Hour Magic"
                    android:textColor="@color/gold_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/pcliq_leaguespartan_regular"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Shoot 1 hour before sunset or after sunrise for warm, flattering skin tones and soft cinematic shadows."
                    android:textColor="@color/text_espresso"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Tip 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/pcliq_bg_quick_action_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pcliq_leaguespartan_bold"
                    android:text="📐 2. Flattering Angles"
                    android:textColor="@color/gold_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/pcliq_leaguespartan_regular"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Hold camera slightly lower than waist level to elongate legs, or at eye level for natural portrait intimacy."
                    android:textColor="@color/text_espresso"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Tip 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/pcliq_bg_quick_action_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pcliq_leaguespartan_bold"
                    android:text="🖐️ 3. Natural Hand Placement"
                    android:textColor="@color/gold_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/pcliq_leaguespartan_regular"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Avoid stiff hands. Keep fingers relaxed, touch sunglasses, adjust jacket collar, or slide one hand casually into a pocket."
                    android:textColor="@color/text_espresso"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Tip 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/pcliq_bg_quick_action_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pcliq_leaguespartan_bold"
                    android:text="🚶‍♂️ 4. Movement &amp; Candid Postures"
                    android:textColor="@color/gold_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/pcliq_leaguespartan_regular"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Instead of freezing in one spot, take slow walking steps, turn around, or look away from the camera for organic, editorial photos."
                    android:textColor="@color/text_espresso"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Button: Open Live Camera -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_open_camera_from_tips"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/pcliq_bg_button_gold"
        android:elevation="4dp"
        android:fontFamily="@font/pcliq_leaguespartan_bold"
        android:letterSpacing="0.06"
        android:text="OPEN LIVE POSE CAMERA 📷"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:cornerRadius="26dp" />

</LinearLayout>
