<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_dash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm">

    <!-- Top Luxury Editorial Brand Header -->
    <LinearLayout
        android:id="@+id/ll_top_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/bg_warm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <!-- Left: High-Fashion Brand Lockup -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.12"
                    android:text="CLIQ"
                    android:textColor="@color/text_espresso"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pcliq_bg_nav_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:text="STUDIO"
                    android:textColor="@color/gold_primary"
                    android:textSize="14sp"
                    android:textStyle="italic" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/pcliq_leaguespartan_bold"
                android:letterSpacing="0.18"
                android:text="EDITORIAL &amp; POSES"
                android:textColor="@color/text_sub_brown"
                android:textSize="9.5sp" />

        </LinearLayout>

        <!-- Right Action: Notifications Button -->
        <ImageView
            android:id="@+id/btn_action_notification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/pcliq_bg_header_action"
            android:clickable="true"
            android:contentDescription="Notifications"
            android:elevation="2dp"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/pcliq_ic_notification_bell"
            app:tint="@color/gold_primary" />

    </LinearLayout>

    <!-- Banner Ad Container (Right below header) -->
    <RelativeLayout
        android:id="@+id/rl_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:layout_below="@+id/ll_top_nav_bar"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Main Content Container -->
    <FrameLayout
        android:id="@+id/fragment_dash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_ad" />

    <!-- Ultra Minimalist Floating Capsule Dock (Icon-Only, 4 Centered Tabs) -->
    <LinearLayout
        android:id="@+id/ll_capsule_dock"
        android:layout_width="240dp"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/pcliq_bg_capsule_dock"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Tab 1: Home -->
        <LinearLayout
            android:id="@+id/dock_item_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_dock_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Home"
                android:src="@drawable/pcliq_ic_nav_home"
                app:tint="@color/gold_primary" />

            <View
                android:id="@+id/dot_dock_home"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/pcliq_bg_nav_dot" />

        </LinearLayout>

        <!-- Tab 2: Poses -->
        <LinearLayout
            android:id="@+id/dock_item_poses"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_dock_poses"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Poses"
                android:src="@drawable/pcliq_ic_nav_poses"
                app:tint="#8A7B70" />

            <View
                android:id="@+id/dot_dock_poses"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/pcliq_bg_nav_dot"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Tab 3: Trending/Popular -->
        <LinearLayout
            android:id="@+id/dock_item_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_dock_favorites"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Trending"
                android:src="@drawable/pcliq_ic_nav_trending"
                app:tint="#8A7B70" />

            <View
                android:id="@+id/dot_dock_favorites"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/pcliq_bg_nav_dot"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Tab 4: Profile -->
        <LinearLayout
            android:id="@+id/dock_item_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_dock_profile"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Profile"
                android:src="@drawable/pcliq_ic_nav_profile"
                app:tint="#8A7B70" />

            <View
                android:id="@+id/dot_dock_profile"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/pcliq_bg_nav_dot"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>