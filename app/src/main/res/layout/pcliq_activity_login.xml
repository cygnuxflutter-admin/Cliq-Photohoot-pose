<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/ll_login_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Cinematic Photoshoot Hero Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="320dp">

            <ImageView
                android:id="@+id/iv1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/pcliq_img_login" />

            <!-- Top Vignette for Status Bar Visibility -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_alignParentTop="true"
                android:background="@drawable/pcliq_bg_hero_gradient" />

            <!-- Soft Bottom Gradient Transition into Card -->
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/pcliq_bg_pose_gradient" />

            <!-- Floating Top Bar: Brand Pill & Skip Button -->
            <RelativeLayout
                android:id="@+id/rl_login_top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:paddingStart="20dp"
                android:paddingTop="36dp"
                android:paddingEnd="20dp">

                <!-- Studio Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/pcliq_bg_badge_gold"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/pcliq_ic_aperture_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pcliq_leaguespartan_bold"
                        android:letterSpacing="0.08"
                        android:text="CLIQ POSES"
                        android:textColor="@color/gold_primary"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Floating Skip Pill -->
                <TextView
                    android:id="@+id/button_skip"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/pcliq_bg_badge_gold"
                    android:fontFamily="@font/pcliq_leaguespartan_semibold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="SKIP →"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

            </RelativeLayout>

        </RelativeLayout>

        <!-- Main Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-36dp"
            android:background="@drawable/pcliq_bg_gradient_top_curve"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Title & Subtitle Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.04"
                    android:text="Welcome Back"
                    android:textColor="@color/text_espresso"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/pcliq_leaguespartan_regular"
                    android:text="Sign in to explore 5,000+ curated photoshoot poses"
                    android:textColor="@color/text_sub_brown"
                    android:textSize="13sp" />

                <!-- Gold Accent Line -->
                <View
                    android:layout_width="44dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="22dp"
                    android:background="@drawable/pcliq_bg_button_gold" />

            </LinearLayout>

            <!-- Email Input Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/pcliq_bg_input_field"
                android:elevation="1dp"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/pcliq_ic_email"
                app:startIconTint="@color/gold_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_login_email"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:fontFamily="@font/pcliq_leaguespartan_regular"
                    android:hint="@string/email"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="@color/text_espresso"
                    android:textColorHint="@color/text_light_brown"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Input Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/pcliq_bg_input_field"
                android:elevation="1dp"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_sub_brown"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/pcliq_ic_password"
                app:startIconTint="@color/gold_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_login_password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:fontFamily="@font/pcliq_leaguespartan_regular"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/text_espresso"
                    android:textColorHint="@color/text_light_brown"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Remember Me & Forgot Password Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/ll_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <cn.refactor.library.SmoothCheckBox
                        android:id="@+id/cb_rememberme"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        app:color_checked="@color/gold_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/pcliq_leaguespartan_medium"
                        android:text="@string/remember_me"
                        android:textColor="@color/text_espresso"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_forgotpass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/pcliq_leaguespartan_bold"
                    android:padding="4dp"
                    android:text="@string/forgot_pass"
                    android:textColor="@color/gold_primary"
                    android:textSize="13sp" />

            </RelativeLayout>

            <!-- Primary Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_login"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/pcliq_bg_button_gold"
                android:elevation="4dp"
                android:fontFamily="@font/pcliq_leaguespartan_bold"
                android:letterSpacing="0.08"
                android:text="SIGN IN"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:cornerRadius="27dp" />

            <com.facebook.login.widget.LoginButton
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- "Or Continue With" Divider -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:layout_toStartOf="@id/tv_other_login"
                    android:background="#E5DDD5" />

                <TextView
                    android:id="@+id/tv_other_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/pcliq_leaguespartan_regular"
                    android:text="Or continue with"
                    android:textColor="@color/text_sub_brown"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/tv_other_login"
                    android:background="#E5DDD5" />

            </RelativeLayout>

            <!-- Social Login: Vector Google Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/btn_login_fb"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/pcliq_btn_facebook"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_login_google"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="3dp"
                    app:cardPreventCornerOverlap="false"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="#25C19543"
                    app:strokeWidth="1.5dp">

                    <ImageView
                        android:id="@+id/btn_login_google"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:contentDescription="Google Login"
                        android:src="@drawable/pcliq_ic_google" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Sign Up Prompt -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pcliq_leaguespartan_regular"
                    android:text="Don’t have an account? "
                    android:textColor="@color/text_sub_brown"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_sign_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/pcliq_leaguespartan_bold"
                    android:padding="4dp"
                    android:text="Sign up"
                    android:textColor="@color/gold_primary"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>