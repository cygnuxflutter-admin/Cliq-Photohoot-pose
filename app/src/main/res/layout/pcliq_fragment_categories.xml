<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm">

    <!-- Top Search & Filters Header -->
    <LinearLayout
        android:id="@+id/ll_cat_top_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <!-- Live Search Bar -->
        <LinearLayout
            android:id="@+id/ll_cat_search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/pcliq_bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/search"
                android:src="@drawable/pcliq_ic_search_gold" />

            <EditText
                android:id="@+id/et_cat_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/pcliq_leaguespartan_regular"
                android:hint="Search categories — Bride, Couple, Boy..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_espresso"
                android:textColorHint="@color/text_sub_brown"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/iv_clear_cat_search"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Clear"
                android:padding="2dp"
                android:src="@drawable/pcliq_ic_close"
                android:visibility="gone"
                app:tint="@color/text_sub_brown" />

        </LinearLayout>

        <!-- Mood & Theme Filter Chips (Horizontal) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_cat_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <!-- Stats & Surprise Me Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_collection_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/pcliq_leaguespartan_bold"
                android:letterSpacing="0.04"
                android:text="✨ CURATED COLLECTIONS"
                android:textColor="@color/gold_primary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/btn_surprise_category"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/pcliq_bg_badge_gold"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/pcliq_ic_shuffle_gold"
                    app:tint="@color/gold_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/pcliq_leaguespartan_bold"
                    android:text="Surprise Me"
                    android:textColor="@color/gold_primary"
                    android:textSize="10.5sp" />

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

    <!-- Categories List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_cat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ll_cat_top_header"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="84dp" />

    <TextView
        android:id="@+id/tv_empty_cat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:fontFamily="@font/pcliq_leaguespartan_medium"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/no_data_found"
        android:textColor="@color/text_sub_brown"
        android:visibility="gone" />

    <ProgressBar android:indeterminateTint="@color/gold_primary"
        android:id="@+id/pb_cat"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>
