<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="210dp"
    android:layout_marginEnd="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rootlayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:strokeColor="#20C19543"
        app:strokeWidth="1.2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Pose Image from User's API -->
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/iv_wallpaper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:riv_corner_radius="18dp" />

            <!-- Dark Scrim Gradient -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/pcliq_bg_pose_gradient" />

            <!-- Optional PRO Badge -->
            <TextView
                android:id="@+id/tv_pro_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/pcliq_bg_pro_badge"
                android:fontFamily="@font/pcliq_leaguespartan_bold"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="PRO"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />

            <!-- Frosted Glass Favorite Button -->
            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_margin="7dp"
                android:background="@drawable/pcliq_bg_fav_circle"
                android:elevation="3dp">

                <com.like.LikeButton
                    android:id="@+id/button_wall_fav"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:anim_scale_factor="2"
                    app:circle_end_color="@color/gold_primary"
                    app:circle_start_color="@color/red"
                    app:dots_primary_color="@color/gold_primary"
                    app:dots_secondary_color="@color/gold_secondary"
                    app:icon_size="14dp"
                    app:is_enabled="true"
                    app:like_drawable="@drawable/pcliq_ic_heart_filled"
                    app:unlike_drawable="@drawable/pcliq_ic_heart_outline" />

            </FrameLayout>

            <!-- Bottom Title & Tag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tv_wall_cat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/pcliq_leaguespartan_semibold"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="Pose"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp" />

            </LinearLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
