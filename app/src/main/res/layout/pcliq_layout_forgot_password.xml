<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_add_playlist"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pcliq_bg_gradient_top_curve"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/tv1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/forgot_pass"
        android:textColor="@color/text_espresso"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/pcliq_leaguespartan_regular"
        android:text="@string/forgot_password_message"
        android:textColor="@color/text_sub_brown"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@+id/tv1" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/pcliq_bg_edittext"
        android:elevation="1dp"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        app:hintEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv2"
        app:startIconDrawable="@drawable/pcliq_ic_email"
        app:startIconTint="@color/gold_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_forgot_email"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@null"
            android:fontFamily="@font/pcliq_leaguespartan_regular"
            android:hint="@string/email"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:textColor="@color/text_espresso"
            android:textColorHint="@color/text_light_brown"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_forgot_send"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/pcliq_bg_button_gold"
        android:elevation="3dp"
        android:fontFamily="@font/pcliq_leaguespartan_semibold"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:text="@string/send"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/til1" />

</androidx.constraintlayout.widget.ConstraintLayout>