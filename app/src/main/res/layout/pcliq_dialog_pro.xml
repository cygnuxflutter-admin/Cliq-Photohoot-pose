<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/bg_warm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlock Pro Pose"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="@color/text_espresso"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Watch a short video ad to unlock and view this premium pose."
            android:textSize="15sp"
            android:textAlignment="center"
            android:textColor="@color/text_sub_brown"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/pcliq_leaguespartan_regular"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:padding="12dp"
                android:text="Cancel"
                android:textColor="@color/text_sub_brown"
                android:background="@drawable/pcliq_bg_button_cancel"
                android:textAlignment="center"
                android:fontFamily="@font/pcliq_leaguespartan_semibold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_watch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:padding="12dp"
                android:text="Watch Video"
                android:textColor="#FFFFFF"
                android:background="@drawable/pcliq_bg_button_gold"
                android:textAlignment="center"
                android:fontFamily="@font/pcliq_leaguespartan_semibold"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

