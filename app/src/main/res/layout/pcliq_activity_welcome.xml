<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm"
    tools:context=".PCliq_Activity.PCliq_WelcomeActivity">

    <!-- Top Cinematic Photoshoot Hero Section -->
    <RelativeLayout
        android:id="@+id/rl_welcome_hero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_welcome_card_container"
        android:layout_marginBottom="-30dp">

        <ImageView
            android:id="@+id/iv_welcome_hero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/pcliq_img_login" />

        <!-- Top Dark Vignette for Status Bar & Header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_alignParentTop="true"
            android:background="@drawable/pcliq_bg_hero_gradient" />

        <!-- Soft Bottom Gradient Transition into Card -->
        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/pcliq_bg_pose_gradient" />

        <!-- Floating Top Bar: Brand Pill & Skip Button -->
        <RelativeLayout
            android:id="@+id/rl_welcome_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:paddingStart="20dp"
            android:paddingTop="36dp"
            android:paddingEnd="20dp">

            <!-- Studio Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/pcliq_bg_badge_gold"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/pcliq_ic_aperture_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pcliq_leaguespartan_bold"
                    android:letterSpacing="0.08"
                    android:text="CLIQ POSES"
                    android:textColor="@color/gold_primary"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Floating Skip Pill -->
            <TextView
                android:id="@+id/button_skip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/pcliq_bg_badge_gold"
                android:fontFamily="@font/pcliq_leaguespartan_semibold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="SKIP →"
                android:textColor="@color/white"
                android:textSize="11.5sp" />

        </RelativeLayout>

    </RelativeLayout>

    <!-- Bottom Curved Card Container -->
    <LinearLayout
        android:id="@+id/ll_welcome_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/pcliq_bg_gradient_top_curve"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Top Handle Indicator -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/pcliq_sheet_handle" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="Master Every Pose"
            android:textColor="@color/text_espresso"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/pcliq_leaguespartan_regular"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Curated poses, live camera silhouette guides, and professional lighting tips for your best photoshoot."
            android:textColor="@color/text_sub_brown"
            android:textSize="13.5sp" />

        <!-- Primary Action: SIGN UP Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_welcome_signup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/pcliq_bg_button_gold"
            android:elevation="4dp"
            android:fontFamily="@font/pcliq_leaguespartan_bold"
            android:letterSpacing="0.06"
            android:text="CREATE ACCOUNT"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@null"
            app:cornerRadius="26dp" />

        <!-- Secondary Action: LOGIN Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_welcome_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pcliq_bg_button_gold_outline"
            android:elevation="0dp"
            android:fontFamily="@font/pcliq_leaguespartan_bold"
            android:letterSpacing="0.06"
            android:text="LOG IN"
            android:textAllCaps="true"
            android:textColor="@color/gold_primary"
            android:textSize="14sp"
            app:backgroundTint="@null"
            app:cornerRadius="26dp"
            app:strokeColor="@color/gold_primary"
            app:strokeWidth="1.5dp" />

        <!-- Guest Link -->
        <TextView
            android:id="@+id/tv_welcome_guest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/pcliq_leaguespartan_semibold"
            android:padding="6dp"
            android:text="Continue as Guest"
            android:textColor="@color/gold_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</RelativeLayout>