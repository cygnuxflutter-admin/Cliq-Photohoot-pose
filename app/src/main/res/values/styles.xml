<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/gold_primary</item>
        <item name="colorSecondaryVariant">@color/gold_dark</item>
        <item name="colorControlActivated">@color/gold_primary</item>
        <item name="android:windowBackground">@color/bg_warm</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:statusBarColor">@color/bg_warm</item>
        <item name="android:navigationBarColor">@color/nav_bottom_bg</item>
        <item name="android:textColorPrimary">@color/text_espresso</item>
        <item name="android:editTextColor">@color/text_espresso</item>
        <item name="android:textColorHint">@color/text_light_brown</item>
        <item name="searchViewStyle">@style/PCliq_SearchViewStyle</item>
    </style>

    <style name="PCliq_SearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@android:color/transparent</item>
        <item name="submitBackground">@android:color/transparent</item>
        <item name="searchIcon">@drawable/pcliq_ic_search_gold</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="fontFamily">@font/pcliq_leaguespartan_semibold</item>
        <item name="android:textColorPrimary">@color/text_espresso</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="NavigationDrawer">
        <item name="android:fontFamily">@font/pcliq_leaguespartan_semibold</item>
    </style>

    <style name="PCliq_BottomNavTextActive">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/pcliq_leaguespartan_bold</item>
    </style>

    <style name="PCliq_BottomNavTextInactive">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/pcliq_leaguespartan_medium</item>
    </style>

    <style name="RatingBar" parent="Widget.AppCompat.RatingBar.Small">
        <item name="colorControlNormal">@color/text_light_brown</item>
        <item name="colorControlActivated">@color/gold_primary</item>
    </style>

    <style name="RatingBar_Wall" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/text_light_brown</item>
        <item name="colorControlActivated">@color/gold_primary</item>
    </style>

    <style name="ThemeDialog" parent="@style/Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:textColorPrimary">@color/text_black</item>
        <item name="android:textColorSecondary">@color/text_title</item>
        <item name="android:textColor">@color/text_black</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/negative_button</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/positive_button</item>
    </style>

    <style name="TextLabel_GREY" parent="AppTheme">
        <item name="android:textColorHint">@color/text_light_brown</item>
        <item name="colorAccent">@color/gold_primary</item>
        <item name="fontFamily">@font/pcliq_leaguespartan_medium</item>
    </style>

    <style name="ToolbarLightDark" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="iconTint">@color/text_espresso</item>
        <item name="colorControlNormal">@color/text_espresso</item>
        <item name="fontFamily">@font/pcliq_leaguespartan_semibold</item>
        <item name="popupMenuBackground">@color/bg</item>
    </style>

</resources>
