<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Force the same warm background even in night mode to prevent black screen flash -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/bg_warm</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:statusBarColor">@color/bg_warm</item>
        <item name="android:navigationBarColor">@color/nav_bottom_bg</item>
    </style>

    <style name="ThemeDialog" parent="@style/Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#E0E0E0</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/negative_button</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/positive_button</item>
    </style>

    <style name="ToolbarLightDark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="iconTint">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="fontFamily">@font/pcliq_leaguespartan_semibold</item>
        <item name="popupMenuBackground">@color/bg_lite</item>
    </style>

    <style name="PCliq_PopupMenuStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/pcliq_bg_popup_menu</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="PCliq_PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:textColor">@color/text_espresso</item>
        <item name="android:textColorPrimary">@color/text_espresso</item>
        <item name="actionMenuTextColor">@color/text_espresso</item>
        <item name="colorControlHighlight">#20C19543</item>
        <item name="popupMenuStyle">@style/PCliq_PopupMenuStyle</item>
        <item name="android:popupMenuStyle">@style/PCliq_PopupMenuStyle</item>
        <item name="android:itemTextAppearance">@style/PCliq_PopupItemTextAppearance</item>
    </style>

    <style name="PCliq_PopupItemTextAppearance" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@color/text_espresso</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/pcliq_leaguespartan_semibold</item>
        <item name="fontFamily">@font/pcliq_leaguespartan_semibold</item>
    </style>

</resources>