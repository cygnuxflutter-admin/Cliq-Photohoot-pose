<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/gold_primary</item>
        <item name="colorSecondaryVariant">@color/gold_dark</item>
        <item name="colorControlActivated">@color/gold_primary</item>
        <item name="android:windowBackground">@color/bg_warm</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:statusBarColor">@color/bg_warm</item>
        <item name="android:navigationBarColor">@color/nav_bottom_bg</item>
        <item name="android:textColorPrimary">@color/text_espresso</item>
        <item name="android:editTextColor">@color/text_espresso</item>
        <item name="android:textColorHint">@color/text_light_brown</item>
        <item name="searchViewStyle">@style/PCliq_SearchViewStyle</item>
        <item name="popupMenuStyle">@style/PCliq_PopupMenuStyle</item>
        <item name="android:popupMenuStyle">@style/PCliq_PopupMenuStyle</item>
        <item name="actionOverflowMenuStyle">@style/PCliq_PopupMenuStyle</item>
        
        <!-- Splash Screen Attributes for Android 12+ -->
        <item name="android:windowSplashScreenBackground">@color/bg_warm</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/pose</item>
    </style>
</resources>